# Required — copy to .env and fill in values before running.
DATABASE_URL=mysql+pymysql://app_user:app_password@localhost:3306/task_knowledge_db
DB_HOST=localhost
DB_PORT=3306
DB_NAME=task_knowledge_db
DB_USER=app_user
DB_PASSWORD=app_password

JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

UPLOAD_DIR=./uploads
VECTOR_STORE_PATH=./vector_store
MAX_UPLOAD_SIZE_MB=20

CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO
